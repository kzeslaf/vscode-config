{
	"Doxygen Comment": {
		"prefix": "dox",
		"body": [
			"/**",
			" * $0",
			" */"
		]
	},
	"Include Guard": {
		"prefix": "once",
		"body": [
			"#ifndef ${1:${TM_FILENAME_BASE/(.*)/${0:/upcase}/}}_H_",
			"#define $1_H_",
			"",
			"$0",
			"",
			"#endif /* $1_H_ */"
		]
	},
	"Namespace": {
		"prefix": "ns",
		"body": [
			"namespace ${1:name} {",
			"$0",
			"}  // namespace $1"
		]
	},

	/////////////////////////////
	// Log
	/////////////////////////////

	"Log Error": {
		"prefix": "error",
		"body": [
			"printf(Log::LOG_ERROR, \"$0\")"
		]
	},
	"Log Warn": {
		"prefix": "warn",
		"body": [
			"printf(Log::LOG_WARNING, \"$0\")"
		]
	},
	"Log Info": {
		"prefix": "info",
		"body": [
			"printf(Log::LOG_INFO, \"$0\")"
		]
	},
	"Log Debug": {
		"prefix": "debug",
		"body": [
			"printf(Log::LOG_DEBUG, \"$0\")"
		]
	}
}
