{
	"dox": {
		"prefix": "dox",
		"body": [
			"/**",
			" * ${0}",
			" */"
		],
		"description": "Doxygen Comment"
	},
	"include guard": {
		"prefix": "once",
		"body": [
			"#ifndef ${1:PROJECT_FILE}_H_",
			"#define ${1:PROJECT_FILE}_H_",
			"",
			"${0}",
			"",
			"#endif /* ${1:PROJECT_FILE}_H_ */"
		],
		"description": "Include Guard"
	},
	"namespace": {
		"prefix": "ns",
		"body": [
			"namespace ${1:name} {",
			"${0}",
			"}  // namespace ${1:name}"
		],
		"description": "Namespace"
	},
	"log error": {
		"prefix": "error",
		"body": [
			"printf(Log::LOG_ERROR, \"${0}\")"
		],
		"description": "Log Error"
	},
	"log warn": {
		"prefix": "warn",
		"body": [
			"printf(Log::LOG_WARNING, \"${0}\")"
		],
		"description": "Log Warn"
	},
	"log info": {
		"prefix": "info",
		"body": [
			"printf(Log::LOG_INFO, \"${0}\")"
		],
		"description": "Log Info"
	},
	"log debug": {
		"prefix": "debug",
		"body": [
			"printf(Log::LOG_DEBUG, \"${0}\")"
		],
		"description": "Log Debug"
	}
}
